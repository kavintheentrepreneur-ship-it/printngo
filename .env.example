# ==============================================================================
# Printngo Environment Variables Configuration
# Copy this file to .env and fill in real values before running in production.
# Never commit .env with real credentials.
# ==============================================================================

# Core Ports & URLs
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
CUSTOMER_APP_URL=http://localhost:3000
KIOSK_APP_URL=http://localhost:3001

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://printngo:printngo_password@localhost:5432/printngo_db?schema=public"

# File Storage Configuration (Cloudflare R2 / S3 / MinIO)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=printngo-jobs
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Payment Configuration (Razorpay or manual_upi)
PAYMENT_PROVIDER=razorpay
UPI_ID=printngo@okhdfcbank
PAYEE_NAME=PrintNGo

# Razorpay Credentials (required if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Kiosk Authentication Secrets (used for HMAC signing)
DEFAULT_KIOSK_ID=kiosk_dev_01
DEFAULT_KIOSK_SECRET=kiosk_super_secret_hmac_key_32_chars
STAFF_PIN_HASH=$2b$10$abcdefghijklmnopqrstuvwxyz1234567890abcdefghijklm # Example hash of PIN '1234'
STAFF_JWT_SECRET=super_secret_jwt_key_for_staff_auth_min_32_chars

# LibreOffice Headless Converter (for DOCX conversion)
LIBREOFFICE_CONVERTER_URL=http://localhost:3005

# Local Printer Configuration (Print Agent)
PRINTER_NAME=
PRINTER_PAPER_SIZES=a4,a3,a5,letter,legal
