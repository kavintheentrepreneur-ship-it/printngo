{
  "name": "printngo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Printngo - QR-code-driven self-service printing kiosk system",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --filter @printngo/shared test",
    "test:all": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "dev:api": "pnpm --filter @printngo/api dev",
    "dev:customer": "pnpm --filter @printngo/customer-web dev",
    "dev:kiosk": "pnpm --filter @printngo/kiosk-web dev",
    "dev:agent": "pnpm --filter @printngo/print-agent dev"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  }
}
